@echo off
chcp 65001 >nul
cd /d "%~dp0"
title СвязьТелеком — локальный сервер

echo ============================================================
echo   Информационная система "СвязьТелеком"
echo   Запуск локального веб-сервера...
echo ============================================================
echo.

REM Запускаем веб-сервер в отдельном свёрнутом окне
where py >nul 2>nul
if %errorlevel%==0 (
    start "СвязьТелеком — сервер" /min py -m http.server 8123 --bind 127.0.0.1
) else (
    start "СвязьТелеком — сервер" /min python -m http.server 8123 --bind 127.0.0.1
)

REM Небольшая пауза, чтобы сервер успел подняться
timeout /t 2 /nobreak >nul

REM Открываем сайт в браузере по умолчанию
start "" "http://127.0.0.1:8123/index.html"

echo.
echo   Сайт открыт по адресу:  http://127.0.0.1:8123/
echo.
echo   Чтобы ОСТАНОВИТЬ сайт — просто закройте свёрнутое окно
echo   "СвязьТелеком — сервер".
echo.
echo   Это окно можно закрыть.
pause >nul
